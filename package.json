{
  "name": "jarvis-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local Jarvis-style desktop assistant HUD.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "electron": "electron .",
    "start": "concurrently -k \"npm run dev\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "start:lite": "npm run build && set JARVIS_PROD=1&& set JARVIS_LITE=1&& electron .",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "electron": "^32.0.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0",
    "wait-on": "^8.0.0"
  },
  "devDependencies": {}
}
